# Database
MONGODB_URI=your_mongodb_connection_string

# JWT  
JWT_SECRET=your_jwt_secret

# Server
PORT=5000
FRONTEND_URL=https://shift.kingkebaborder.co.kr

# Telegram bots (separate)
# Notifications / admin alerts
TELEGRAM_BOT_TOKEN=1234567890:YOUR_NOTIFICATION_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_IDS=your_telegram_chat_id
# Mini App auth (Open App button bot)
TELEGRAM_MINI_APP_BOT_TOKEN=1234567890:YOUR_MINI_APP_BOT_TOKEN
# Public backend URL for /start webhook (Render sets RENDER_EXTERNAL_URL automatically)
BACKEND_PUBLIC_URL=https://YOUR-BACKEND.onrender.com
# Optional: webhook secret (defaults to JWT_SECRET)
# TELEGRAM_MINI_APP_WEBHOOK_SECRET=random-secret
# Mini App URL is FRONTEND_URL — Menu Button is set automatically on boot
